{
  "source": "// Composed with ergo-forge: 2 spending paths. Paths are OR-ed; a path's\n// conditions are AND-ed.\n// $owner: SigmaProp\n// $keepPct: Long\n// $feeTo: SigmaProp\n// $fee: Long\n// $cooldown: Int\n// $oracleNFT: Coll[Byte]\n// $ceiling: Long\n// $secretHash: Coll[Byte]\n// $refund: Long\n{\n  // path1: owner ticks the box\n  val path1 = $owner &&\n    sigmaProp((OUTPUTS.size > 0 && OUTPUTS(0).propositionBytes == SELF.propositionBytes && OUTPUTS(0).value >= SELF.value * $keepPct / 100L && OUTPUTS(0).tokens == SELF.tokens && OUTPUTS(0).R4[Int].isDefined && OUTPUTS(0).R4[Int].get == HEIGHT && SELF.R5[Coll[Byte]].isDefined && OUTPUTS(0).R5[Coll[Byte]].isDefined && OUTPUTS(0).R5[Coll[Byte]].get == SELF.R5[Coll[Byte]].get) &&\n              (OUTPUTS.size > 1 && OUTPUTS(1).propositionBytes == $feeTo.propBytes && OUTPUTS(1).value >= $fee) &&\n              HEIGHT - SELF.creationInfo._1 >= $cooldown)\n  // path2: anyone closes it on a low price with the secret\n  val path2 = sigmaProp((CONTEXT.dataInputs.size > 0 && CONTEXT.dataInputs(0).tokens.exists { (t: (Coll[Byte], Long)) => t._1 == $oracleNFT } && CONTEXT.dataInputs(0).R4[Long].isDefined && CONTEXT.dataInputs(0).R4[Long].get <= $ceiling) &&\n              (getVar[Coll[Byte]](0).isDefined && blake2b256(getVar[Coll[Byte]](0).get) == $secretHash) &&\n              OUTPUTS.fold(0L, { (acc: Long, bx: Box) => if (bx.propositionBytes == $owner.propBytes) acc + bx.value else acc }) >= $refund &&\n              OUTPUTS.forall { (bx: Box) => bx.tokens.size == 0 })\n  path1 || path2\n}\n",
